PORT=4000
NODE_ENV=production

# Firebase — local dev: set GOOGLE_APPLICATION_CREDENTIALS to file path
# Railway / cloud: paste the entire service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=car-rental-3a89c
FIREBASE_STORAGE_BUCKET=gs://car-rental-3a89c.appspot.com

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://car-rental-3a89c.web.app,https://www.rentnhost.com

# Razorpay (get keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Gmail App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RentNHost <noreply@rentnhost.com>
CONTACT_INBOX=admin@rentnhost.com

APP_URL=https://car-rental-3a89c.web.app
